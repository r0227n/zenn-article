{
  "name": "article",
  "version": "1.0.0",
  "description": "記事保存用のリポジトリ",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "dev": "bun run src/index.ts",
    "start": "bun dist/index.js",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:types": "oxlint --type-aware",
    "format": "oxfmt && dprint fmt",
    "format:check": "oxfmt --check && dprint check",
    "format:ts": "oxfmt --write",
    "format:other": "dprint fmt",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r0227n/article.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/r0227n/article/issues"
  },
  "homepage": "https://github.com/r0227n/article#readme",
  "dependencies": {
    "zenn-cli": "^0.2.11"
  },
  "engines": {
    "bun": ">=1.3.5"
  },
  "packageManager": "bun@1.3.5"
}
